        "month": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "month_of_year": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "nominal_gdp": {
          "format": "double",
          "type": "number"
