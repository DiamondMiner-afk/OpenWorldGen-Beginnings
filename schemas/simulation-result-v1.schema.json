        },
        "real_gdp": {
          "format": "double",
          "type": "number"
        },
        "replication": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scenario_id": {
          "type": "string"
        },
        "unemployment": {
          "format": "double",
          "type": "number"
        },
        "year": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "scenario_id",
        "branch_id",
        "replication",
        "month",
        "year",
        "month_of_year",
        "cpi",
        "cpi_energy",
        "cpi_food",
        "cpi_manufacturing",
        "cpi_services",
        "inflation_year_over_year",
        "real_gdp",
        "nominal_gdp",
        "output_gap",
        "unemployment",
        "average_wage",
        "consumption_total",
        "consumption_deciles",
        "gini",
        "poverty_share",
        "inventories",
