          "format": "double",
          "type": "number"
        },
        "mean_output_gap": {
          "format": "double",
          "type": "number"
        },
        "mean_unemployment": {
          "format": "double",
          "type": "number"
        },
        "peak_credit_mean": {
          "format": "double",
          "type": "number"
        },
        "peak_inflation_mean": {
          "format": "double",
          "type": "number"
        },
        "peak_inflation_month": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
