{
  "$defs": {
    "AccountingDiagnostic": {
      "properties": {
        "branch_id": {
          "type": "string"
        },
        "max_income_identity_relative_error": {
          "format": "double",
          "type": "number"
        },
        "max_institutional_balance_residual_minor_units": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_national_accounts_relative_error": {
          "format": "double",
          "type": "number"
        },
        "max_unclassified_balance_minor_units": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "observation_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "branch_id",
        "observation_count",
        "max_national_accounts_relative_error",
        "max_income_identity_relative_error",
        "max_institutional_balance_residual_minor_units",
        "max_unclassified_balance_minor_units"
      ],
      "type": "object"
    },
    "ComparisonReport": {
      "properties": {
        "caveat": {
          "type": "string"
        },
        "confidence_level": {
          "format": "double",
          "type": "number"
        },
        "evaluation_end_month": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "evaluation_start_month": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "minimax_regret_branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "pareto_frontier": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scenario_id": {
          "type": "string"
        },
        "scores": {
          "items": {
            "$ref": "#/$defs/PolicyScore"
          },
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "evaluation_start_month",
        "evaluation_end_month",
        "confidence_level",
        "scores",
        "pareto_frontier",
        "caveat"
      ],
      "type": "object"
    },
    "ComputeProfile": {
      "enum": [
        "minimal",
        "standard",
        "custom"
      ],
      "type": "string"
    },
    "ConfidenceInterval": {
      "properties": {
        "lower": {
          "format": "double",
          "type": "number"
        },
        "mean": {
          "format": "double",
          "type": "number"
        },
        "replication_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "upper": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "mean",
        "lower",
        "upper",
        "replication_count"
      ],
      "type": "object"
    },
    "ContractCreditMetrics": {
      "properties": {
        "active_contracts": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "audit": {
          "$ref": "#/$defs/CreditAudit"
        },
        "interest_receivable": {
          "$ref": "#/$defs/Money"
        },
        "principal": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "principal",
        "interest_receivable",
        "active_contracts",
        "audit"
      ],
      "type": "object"
    },
    "CreditAudit": {
      "properties": {
        "accrued_interest": {
          "$ref": "#/$defs/Money"
        },
        "bank_originated_principal": {
          "$ref": "#/$defs/Money"
        },
        "customer_funded_principal": {
          "$ref": "#/$defs/Money"
        },
        "event_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "last_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/CreditEvent"
            },
            {
              "type": "null"
            }
          ]
        },
        "paid_interest": {
          "$ref": "#/$defs/Money"
        },
        "paid_principal": {
          "$ref": "#/$defs/Money"
        },
        "rejected_contracts": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rolling_hash": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 32,
          "type": "array"
        },
        "written_off": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "event_count",
        "rolling_hash",
        "bank_originated_principal",
        "customer_funded_principal",
        "accrued_interest",
        "paid_interest",
        "paid_principal",
        "written_off",
        "rejected_contracts"
      ],
      "type": "object"
    },
    "CreditEvent": {
      "properties": {
        "borrower_id": {
          "type": "string"
        },
        "contract_id": {
          "type": "string"
        },
        "interest": {
          "$ref": "#/$defs/Money"
        },
        "kind": {
          "$ref": "#/$defs/CreditEventKind"
        },
        "lender_id": {
          "type": "string"
        },
        "month": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "principal": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "contract_id",
        "lender_id",
        "borrower_id",
        "month",
        "kind",
        "principal",
        "interest"
      ],
      "type": "object"
    },
    "CreditEventKind": {
      "enum": [
        "bank_origination",
        "customer_origination",
        "rejected_funding",
        "rejected_law",
        "interest_accrued",
        "payment",
        "write_off"
      ],
      "type": "string"
    },
    "EventAudit": {
      "properties": {
        "contract_credit_audit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CreditAudit"
            },
            {
              "type": "null"
            }
          ]
        },
        "entries_by_month": {
          "additionalProperties": false,
          "patternProperties": {
            "^\\d+$": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "entries_by_phase": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "entry_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "first_entry_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "first_scheduled_event_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "governance_events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GovernanceEvent"
          },
          "type": "array"
        },
        "journal_hash": {
          "type": "string"
        },
        "last_entry_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_scheduled_event_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "posting_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schedule_hash": {
          "default": "",
          "type": "string"
        },
        "scheduled_event_count": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scheduled_events_by_kind": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "scheduled_events_by_month": {
          "additionalProperties": false,
          "default": {},
          "patternProperties": {
            "^\\d+$": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "scheduler_version": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "journal_hash",
        "entry_count",
        "posting_count",
        "entries_by_phase",
        "entries_by_month"
      ],
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "reference",
        "fast"
      ],
      "type": "string"
    },
    "FidelityClass": {
      "enum": [
        "unvalidated",
        "qualitative",
        "policy_comparable",
        "reference"
      ],
      "type": "string"
    },
    "GovernanceEvent": {
      "properties": {
        "actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "description": "V3 decision provenance. These fields identify declared scenario actors,\nnot authenticated real-world officials or external model callers.",
          "type": [
            "string",
            "null"
          ]
        },
        "effective_month": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "month": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "outcome": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string"
        },
        "required": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "support": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "month",
        "proposal_id",
        "phase",
        "outcome"
      ],
      "type": "object"
    },
    "IncomeAccounts": {
