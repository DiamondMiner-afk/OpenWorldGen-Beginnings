      "action_schema": "owg.agent-action.v1"
    },
    {
      "id": "government",
      "policy_id": "automatic-stabilizer-v0.1",
      "state_schema": "owg.government-state.v1",
      "observation_schema": "owg.policy-observation.v1",
      "action_schema": "owg.agent-action.v1"
    },
    {
